@model VentureCarRentals.Pages.Guest.Cars.GuestCarBrowseViewModel

@{
    /*
        // IMPORTANT SS THIS:
        This file is a PARTIAL VIEW only.

        Do NOT add @page here.
        Do NOT create _GuestCarDetailsModal.cshtml.cs.

        This partial receives one GuestCarBrowseViewModel from:
        Pages/Guest/Cars/BrowseCars.cshtml
    */

    var roundedRating = Math.Clamp((int)Math.Round(Model.AverageRating), 0, 5);
    var hasImage = !string.IsNullOrWhiteSpace(Model.ImageUrl);
    var hasDescription = !string.IsNullOrWhiteSpace(Model.Description);
    var hasReviews = Model.RecentReviews.Any();
}

<div class="modal fade"
     id="guestCarDetailsModal-@Model.CarId"
     tabindex="-1"
     aria-labelledby="guestCarDetailsModalLabel-@Model.CarId"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0 rounded-5 shadow-lg overflow-hidden">

            <!-- MODAL HEADER -->
            <div class="modal-header border-0 bg-light px-4 py-3">

                <div class="d-flex align-items-center gap-3">

                    <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center"
                         style="width: 48px; height: 48px;">
                        <i class="bi bi-car-front fs-4"></i>
                    </div>

                    <div>
                        <h5 class="modal-title fw-bold mb-0"
                            id="guestCarDetailsModalLabel-@Model.CarId">
                            @Model.Make @Model.Model
                        </h5>

                        <div class="d-flex flex-wrap align-items-center gap-2 mt-1">
                            <span class="badge rounded-pill text-bg-dark">
                                @Model.Category
                            </span>

                            <span class="small text-muted">
                                @Model.Year Model
                            </span>
                        </div>
                    </div>

                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <!-- MODAL BODY -->
            <div class="modal-body p-4">

                <div class="row g-4">

                    <!-- LEFT SIDE: CAR IMAGE AND PRICE CARD -->
                    <div class="col-lg-5">

                        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                            @if (hasImage)
                            {
                                <img src="@Model.ImageUrl"
                                     alt="@Model.Make @Model.Model"
                                     class="card-img-top"
                                     style="height: 320px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="bg-light d-flex flex-column align-items-center justify-content-center"
                                     style="height: 320px;">
                                    <i class="bi bi-car-front fs-1 text-muted"></i>
                                    <span class="text-muted mt-2">No Image Available</span>
                                </div>
                            }

                            <div class="card-body p-4">

                                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                                    <div>
                                        <p class="text-muted small mb-1">
                                            Rental Price
                                        </p>

                                        <h3 class="fw-bold mb-0">
                                            ₱@Model.PricePerDay.ToString("N2")
                                        </h3>

                                        <small class="text-muted">
                                            per day
                                        </small>
                                    </div>

                                    <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3 py-2">
                                        @Model.Status
                                    </span>
                                </div>

                                <!-- IMPORTANT SS THIS:
                                     Guest users cannot directly book from this modal.
                                     They must go to /Index first to sign in or register.
                                -->
                                <a href="/Index"
                                   class="btn btn-primary w-100 rounded-pill py-2 fw-semibold">
                                    <i class="bi bi-person-plus me-1"></i>
                                    Join Us to Book
                                </a>

                            </div>
                        </div>

                    </div>

                    <!-- RIGHT SIDE: DETAILS -->
                    <div class="col-lg-7">

                        <!-- RATING SUMMARY -->
                        <div class="card border-0 shadow-sm rounded-4 mb-4">
                            <div class="card-body p-4">

                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                                    <div>
                                        <h5 class="fw-bold mb-1">
                                            Vehicle Overview
                                        </h5>

                                        <p class="text-muted mb-0">
                                            Review vehicle specifications before signing in to book.
                                        </p>
                                    </div>

                                    <div class="text-lg-end">
                                        <div class="mb-1">
                                            @for (var i = 1; i <= 5; i++)
                                            {
                                                if (i <= roundedRating)
                                                {
                                                    <i class="bi bi-star-fill text-warning"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-star text-warning"></i>
                                                }
                                            }
                                        </div>

                                        @if (Model.ReviewCount > 0)
                                        {
                                            <small class="text-muted">
                                                @Model.AverageRating.ToString("0.0") / 5 • @Model.ReviewCount review(s)
                                            </small>
                                        }
                                        else
                                        {
                                            <small class="text-muted">
                                                No reviews yet
                                            </small>
                                        }
                                    </div>

                                </div>

                            </div>
                        </div>

                        <!-- SPECIFICATION CARDS -->
                        <div class="row g-3 mb-4">

                            <div class="col-md-6">
                                <div class="border rounded-4 p-3 h-100">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center"
                                             style="width: 42px; height: 42px;">
                                            <i class="bi bi-people"></i>
                                        </div>

                                        <div>
                                            <small class="text-muted">Seats</small>
                                            <h6 class="fw-bold mb-0">@Model.Seats passengers</h6>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="border rounded-4 p-3 h-100">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center"
                                             style="width: 42px; height: 42px;">
                                            <i class="bi bi-gear"></i>
                                        </div>

                                        <div>
                                            <small class="text-muted">Transmission</small>
                                            <h6 class="fw-bold mb-0">@Model.Transmission</h6>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="border rounded-4 p-3 h-100">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center"
                                             style="width: 42px; height: 42px;">
                                            <i class="bi bi-palette"></i>
                                        </div>

                                        <div>
                                            <small class="text-muted">Color</small>
                                            <h6 class="fw-bold mb-0">
                                                @(string.IsNullOrWhiteSpace(Model.Color) ? "Not specified" : Model.Color)
                                            </h6>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="border rounded-4 p-3 h-100">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center"
                                             style="width: 42px; height: 42px;">
                                            <i class="bi bi-calendar"></i>
                                        </div>

                                        <div>
                                            <small class="text-muted">Year Model</small>
                                            <h6 class="fw-bold mb-0">@Model.Year</h6>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <!-- DESCRIPTION -->
                        <div class="card border-0 shadow-sm rounded-4 mb-4">
                            <div class="card-body p-4">

                                <h6 class="fw-bold mb-2">
                                    <i class="bi bi-card-text me-1"></i>
                                    Description
                                </h6>

                                @if (hasDescription)
                                {
                                    <p class="text-muted mb-0">
                                        @Model.Description
                                    </p>
                                }
                                else
                                {
                                    <p class="text-muted mb-0">
                                        No description provided for this vehicle.
                                    </p>
                                }

                            </div>
                        </div>

                        <!-- RECENT REVIEWS -->
                        <div class="card border-0 shadow-sm rounded-4">
                            <div class="card-body p-4">

                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="fw-bold mb-0">
                                        <i class="bi bi-chat-left-text me-1"></i>
                                        Recent Reviews
                                    </h6>

                                    <span class="badge bg-light text-dark border">
                                        @Model.ReviewCount total
                                    </span>
                                </div>

                                @if (hasReviews)
                                {
                                    <div class="vstack gap-3">

                                        @foreach (var review in Model.RecentReviews)
                                        {
                                            <div class="border rounded-4 p-3">

                                                <div class="d-flex justify-content-between align-items-start gap-3 mb-2">

                                                    <div>
                                                        @for (var i = 1; i <= 5; i++)
                                                        {
                                                            if (i <= review.Rating)
                                                            {
                                                                <i class="bi bi-star-fill text-warning"></i>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-star text-warning"></i>
                                                            }
                                                        }
                                                </div>

                                                <small class="text-muted">
                                                    @review.CreatedAt.ToString("MMM dd, yyyy")
                                                </small>

                                            </div>

                                            <p class="text-muted mb-0">
                                                @(string.IsNullOrWhiteSpace(review.Comment)
                                                                                            ? "No comment provided."
                                                                                            : review.Comment)
                                        </p>

                                            </div>
                                                                        }

                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-4">
                                        <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-2"
                                             style="width: 56px; height: 56px;">
                                            <i class="bi bi-star text-muted fs-4"></i>
                                        </div>

                                        <p class="text-muted mb-0">
                                            No reviews yet for this vehicle.
                                        </p>
                                    </div>
                                }

                            </div>
                        </div>

                    </div>

                </div>

            </div>

            <!-- MODAL FOOTER -->
            <div class="modal-footer border-0 bg-light px-4 py-3">

                <button type="button"
                        class="btn btn-outline-secondary rounded-pill px-4"
                        data-bs-dismiss="modal">
                    Close
                </button>

                <!-- IMPORTANT SS THIS:
                     This sends the guest to the splash page where Sign Up and Sign In are available.
                -->
                <a href="/Index"
                   class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-person-plus me-1"></i>
                    Join Us to Book
                </a>

            </div>

        </div>
    </div>
</div>