@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var isAdminPage = currentPage.StartsWith("/Admin");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Venture Car Rentals</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VentureCarRentals.styles.css" asp-append-version="true" />
</head>

<body>
    @if (isAdminPage)
    {
        <div class="admin-wrapper">
            @await Html.PartialAsync("_AdminSidebar")

            <main class="admin-main">

                <!-- IMPORTANT:
                     This topbar appears only on tablet/mobile.
                     It contains the hamburger button for the admin sidebar.
                -->
                <div class="admin-mobile-topbar">
                    <button type="button" class="admin-menu-btn" onclick="toggleAdminSidebar()">
                        <i class="bi bi-list"></i>
                    </button>

                    <div class="admin-mobile-brand">
                        <img src="~/images/logo.png" asp-append-version="true" alt="Logo" />
                        <span>CAR RENTALS</span>
                    </div>
                </div>

                @RenderBody()
            </main>
        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/app-notifications.js" asp-append-version="true"></script>

    @await Html.PartialAsync("/Pages/Shared/_ToastMessages.cshtml")
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        /*
            IMPORTANT:
            Some browsers restore pages from memory when pressing Back.
            This reloads the page so the server can check the session again.
        */
        window.addEventListener("pageshow", function (event) {
            if (event.persisted) {
                window.location.reload();
            }
        });
    </script>
</body>
</html>