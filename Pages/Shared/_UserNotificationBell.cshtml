<div id="userNotificationBell"
     class="app-notification-wrapper dropdown"
     data-feed-url="@Url.Page("/User/Notifications/Feed", "Latest")"
     data-mark-read-url="@Url.Page("/User/Notifications/Feed", "MarkRead")"
     data-mark-all-read-url="@Url.Page("/User/Notifications/Feed", "MarkAllRead")">

    @Html.AntiForgeryToken()

    <button type="button"
            class="app-notification-button"
            data-bs-toggle="dropdown"
            aria-expanded="false">
        <i class="bi bi-bell"></i>

        <span id="userNotificationCount"
              class="app-notification-count d-none">
            0
        </span>
    </button>

    <div class="dropdown-menu dropdown-menu-end app-notification-dropdown">
        <div class="app-notification-header">
            <div>
                <strong>My Notifications</strong>
                <small id="userNotificationSubtext">Loading...</small>
            </div>

            <button type="button"
                    id="userMarkAllNotificationsReadBtn"
                    class="app-notification-mark-all">
                Mark all read
            </button>
        </div>

        <div id="userNotificationItems" class="app-notification-items">
            <div class="app-notification-empty">
                Loading notifications...
            </div>
        </div>

        <a asp-page="/User/Notifications/Index"
           class="app-notification-view-all">
            View all notifications
        </a>
    </div>
</div>