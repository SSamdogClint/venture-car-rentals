@page
@model VentureCarRentals.Pages.User.Cars.BrowseCarsModel
@{
    ViewData["Title"] = "Browse Cars";
    Layout = "_Layout";

    /*
        IMPORTANT FEATURE:
        Browse Cars works as a public landing/catalog page.

        Guest:
        - No sidebar
        - Can view cars
        - Top bar shows logo + Car Rentals
        - Join Us button redirects to /Index
        - Book button redirects to /Index
        - No notification bell

        Logged-in user:
        - Sidebar is shown
        - User notification bell is shown
        - Book button follows the normal booking/verification flow

        Reviews:
        - Average rating and review count are loaded from the Reviews table.
        - Details modal shows recent review comments.
    */
}

<div class="@(Model.IsLoggedIn ? "user-wrapper" : "public-cars-wrapper")">

    @if (Model.IsLoggedIn)
    {
        @await Html.PartialAsync("/Pages/User/_UserSidebar.cshtml")
    }

    <main class="@(Model.IsLoggedIn ? "user-main" : "public-cars-main")">

        @if (Model.IsLoggedIn)
        {
            <div class="user-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button type="button" class="user-menu-btn" onclick="toggleUserSidebar()">
                        <i class="bi bi-list"></i>
                    </button>

                    <a asp-page="/User/Home" class="back-link">
                        <i class="bi bi-arrow-left"></i> Back
                    </a>
                </div>

                @await Html.PartialAsync("_UserNotificationBell")
            </div>
        }
        else
        {
            <div class="public-cars-topbar">
                <div class="public-brand">
                    <img src="~/images/logo.png" class="public-brand-logo" alt="V Car Rentals Logo" />
                    <span>Car Rentals</span>
                </div>

                <a href="/Index" class="btn btn-primary px-4">
                    Join Us
                </a>
            </div>
        }

        <section class="available-cars-section">

            <div class="d-flex justify-content-between align-items-center mb-2">
                <h3 class="mb-0">@Model.PageHeading</h3>

                <button class="btn btn-outline-dark"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#carFilterPanel"
                        aria-expanded="@(Model.HasActiveFilters ? "true" : "false")"
                        aria-controls="carFilterPanel">
                    <i class="bi bi-funnel"></i> Filter
                </button>
            </div>

            <hr />

            <div class="collapse @(Model.HasActiveFilters ? "show" : "")" id="carFilterPanel">
                <div class="content-card mb-4">
                    <form method="get" class="row g-3 align-items-end">

                        @if (!string.IsNullOrWhiteSpace(Model.BorrowDate))
                        {
                            <input type="hidden" name="BorrowDate" value="@Model.BorrowDate" />
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.BorrowTime))
                        {
                            <input type="hidden" name="BorrowTime" value="@Model.BorrowTime" />
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.ReturnDate))
                        {
                            <input type="hidden" name="ReturnDate" value="@Model.ReturnDate" />
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.ReturnTime))
                        {
                            <input type="hidden" name="ReturnTime" value="@Model.ReturnTime" />
                        }

                        <div class="col-md-3">
                            <label class="form-label">Search</label>
                            <input type="text"
                                   name="SearchTerm"
                                   value="@Model.SearchTerm"
                                   class="form-control"
                                   placeholder="Search car, category..." />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">Category</label>
                            <select name="CategoryFilter" class="form-control">
                                <option value="">All categories</option>

                                @foreach (var category in Model.FilterCategories)
                                {
                                    <option value="@category" selected="@(Model.CategoryFilter == category ? "selected" : null)">
                                        @category
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">Transmission</label>
                            <select name="TransmissionFilter" class="form-control">
                                <option value="">All</option>

                                @foreach (var transmission in Model.FilterTransmissions)
                                {
                                    <option value="@transmission" selected="@(Model.TransmissionFilter == transmission ? "selected" : null)">
                                        @transmission
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-1">
                            <label class="form-label">Seats</label>
                            <input type="number"
                                   name="MinSeats"
                                   value="@Model.MinSeats"
                                   class="form-control"
                                   min="1"
                                   placeholder="Min" />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">Max Price</label>
                            <input type="number"
                                   name="MaxPrice"
                                   value="@Model.MaxPrice"
                                   class="form-control"
                                   min="0"
                                   step="100"
                                   placeholder="₱" />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">Sort</label>
                            <select name="SortBy" class="form-control">
                                <option value="popular" selected="@(Model.SortBy == "popular" ? "selected" : null)">Popular</option>
                                <option value="lowest_price" selected="@(Model.SortBy == "lowest_price" ? "selected" : null)">Lowest Price</option>
                                <option value="highest_price" selected="@(Model.SortBy == "highest_price" ? "selected" : null)">Highest Price</option>
                                <option value="newest" selected="@(Model.SortBy == "newest" ? "selected" : null)">Newest</option>
                            </select>
                        </div>

                        <div class="col-md-12 d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-funnel"></i> Apply Filter
                            </button>

                            <a asp-page="/User/Cars/BrowseCars"
                               asp-route-BorrowDate="@Model.BorrowDate"
                               asp-route-BorrowTime="@Model.BorrowTime"
                               asp-route-ReturnDate="@Model.ReturnDate"
                               asp-route-ReturnTime="@Model.ReturnTime"
                               class="btn btn-light">
                                Clear Filters
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert alert-danger">
                    @Model.ErrorMessage
                </div>
            }
            else
            {
                @if (Model.IsSearchMode)
                {
                    <div class="selected-date-box mb-3">
                        <strong>Borrow:</strong> @Model.BorrowDateTime.ToString("MMM dd, yyyy hh:mm tt")
                        <span class="mx-2">|</span>
                        <strong>Return:</strong> @Model.ReturnDateTime.ToString("MMM dd, yyyy hh:mm tt")
                    </div>
                }
                else
                {
                    <div class="selected-date-box mb-3">
                        Browse available cars. Click Book to start the booking process.
                    </div>
                }

                @if (Model.HasActiveFilters)
                {
                    <div class="alert alert-info">
                        Showing @Model.Cars.Count result(s) based on your selected filters.
                    </div>
                }

                @if (Model.Cars.Any())
                {
                    foreach (var car in Model.Cars)
                    {
                        var totalPrice = Model.IsSearchMode
                        ? Model.TotalDays * car.PricePerDay
                        : car.PricePerDay;

                        <div class="vehicle-card">

                            <div class="vehicle-image-box">
                                @if (!string.IsNullOrWhiteSpace(car.ImageUrl))
                                {
                                    <img src="@car.ImageUrl" alt="@car.Make @car.Model" />
                                }
                                else
                                {
                                    <div class="vehicle-no-image">
                                        <i class="bi bi-car-front"></i>
                                        <span>No Image</span>
                                    </div>
                                }

                                <div class="rating-box">
                                    @for (var i = 1; i <= 5; i++)
                                    {
                                        if (i <= Math.Round(car.AverageRating))
                                        {
                                            <i class="bi bi-star-fill text-warning"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star text-warning"></i>
                                        }
                                    }

                                    @if (car.ReviewCount > 0)
                                    {
                                        <small>@car.AverageRating.ToString("0.0") / 5 • @car.ReviewCount review(s)</small>
                                    }
                                    else
                                    {
                                        <small>No reviews yet</small>
                                    }
                                </div>
                            </div>

                            <div class="vehicle-info">
                                <h5>@car.Make @car.Model - @car.Category</h5>

                                <div class="vehicle-features">
                                    <p><i class="bi bi-calendar"></i> @car.Year Model</p>
                                    <p><i class="bi bi-people"></i> @car.Seats Seats</p>
                                    <p><i class="bi bi-gear"></i> @car.Transmission</p>
                                    <p><i class="bi bi-check-circle"></i> @car.Status</p>
                                    <p><i class="bi bi-palette"></i> @car.Color</p>
                                    <p><i class="bi bi-snow"></i> Airconditioning</p>
                                    <p><i class="bi bi-steering-wheel"></i> Power Steering</p>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(car.Description))
                                {
                                    <p class="text-muted mt-2">
                                        @car.Description
                                    </p>
                                }
                            </div>

                            <div class="vehicle-price">
                                <h4>₱@car.PricePerDay.ToString("N2") <span>/ day</span></h4>

                                @if (Model.IsSearchMode)
                                {
                                    <p>
                                        ₱@totalPrice.ToString("N2") total for<br />
                                        @Model.TotalDays day(s)
                                    </p>

                                    <small>Excl. taxes & insurance(s)</small>
                                }
                                else
                                {
                                    <p>Start booking by signing in or creating an account.</p>
                                    <small>Price may vary depending on duration.</small>
                                }

                                <button type="button"
                                        class="btn btn-outline-dark w-100 mt-3"
                                        data-bs-toggle="modal"
                                        data-bs-target="#carDetailsModal-@car.CarId">
                                    <i class="bi bi-eye"></i> View Details
                                </button>

                                @if (Model.IsSearchMode)
                                {
                                    @if (Model.VerificationStatus == "verified")
                                    {
                                        <a class="book-btn mt-2"
                                           asp-page="/User/Cars/Create"
                                           asp-route-carId="@car.CarId"
                                           asp-route-borrowDate="@Model.BorrowDate"
                                           asp-route-borrowTime="@Model.BorrowTime"
                                           asp-route-returnDate="@Model.ReturnDate"
                                           asp-route-returnTime="@Model.ReturnTime">
                                            Book
                                        </a>
                                    }
                                    else if (Model.VerificationStatus == "needs_requirements")
                                    {
                                        <button type="button"
                                                class="book-btn border-0 mt-2"
                                                data-bs-toggle="modal"
                                                data-bs-target="#verifyAccountModal-@car.CarId">
                                            Complete Verification
                                        </button>
                                    }
                                    else if (Model.VerificationStatus == "pending")
                                    {
                                        <button type="button" class="book-btn not-verified-btn border-0 mt-2" disabled>
                                            Verification Pending
                                        </button>
                                    }
                                    else if (Model.VerificationStatus == "rejected")
                                    {
                                        <a class="book-btn mt-2"
                                           asp-page="/User/Documents/CompleteRequirements"
                                           asp-route-carId="@car.CarId"
                                           asp-route-borrowDate="@Model.BorrowDate"
                                           asp-route-borrowTime="@Model.BorrowTime"
                                           asp-route-returnDate="@Model.ReturnDate"
                                           asp-route-returnTime="@Model.ReturnTime">
                                            Update Documents
                                        </a>
                                    }
                                    else if (Model.VerificationStatus == "expired")
                                    {
                                        <a class="book-btn mt-2"
                                           asp-page="/User/Documents/CompleteRequirements"
                                           asp-route-carId="@car.CarId"
                                           asp-route-borrowDate="@Model.BorrowDate"
                                           asp-route-borrowTime="@Model.BorrowTime"
                                           asp-route-returnDate="@Model.ReturnDate"
                                           asp-route-returnTime="@Model.ReturnTime">
                                            Renew Documents
                                        </a>
                                    }
                                    else
                                    {
                                        <a class="book-btn mt-2" href="/Index">
                                            Book
                                        </a>
                                    }
                                }
                                else
                                {
                                    @if (Model.IsLoggedIn)
                                    {
                                        <a class="book-btn mt-2" asp-page="/User/Home">
                                            Book
                                        </a>
                                    }
                                    else
                                    {
                                        <a class="book-btn mt-2" href="/Index">
                                            Book
                                        </a>
                                    }
                                }
                            </div>

                        </div>

                        @await Html.PartialAsync("_CarDetailsModal", car)

                        @if (Model.IsSearchMode && Model.VerificationStatus == "needs_requirements")
                        {
                            <div class="modal fade" id="verifyAccountModal-@car.CarId" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content verification-modal">
                                        <div class="modal-header">
                                            <h5 class="modal-title">Verify Account First</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>

                                        <div class="modal-body text-center">
                                            <i class="bi bi-shield-check verification-icon"></i>

                                            <h5 class="mt-3">Account verification required</h5>

                                            <p class="text-muted">
                                                Before booking this car, please complete your renter information and upload the required documents for verification.
                                            </p>
                                        </div>

                                        <div class="modal-footer justify-content-center">
                                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">
                                                Cancel
                                            </button>

                                            <a class="btn btn-primary"
                                               asp-page="/User/Documents/CompleteRequirements"
                                               asp-route-carId="@car.CarId"
                                               asp-route-borrowDate="@Model.BorrowDate"
                                               asp-route-borrowTime="@Model.BorrowTime"
                                               asp-route-returnDate="@Model.ReturnDate"
                                               asp-route-returnTime="@Model.ReturnTime">
                                                Continue Verification
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                }
                else
                {
                    <div class="empty-result-box">
                        <i class="bi bi-car-front"></i>

                        @if (Model.IsSearchMode)
                        {
                            <h5>No available cars found</h5>
                            <p>No cars matched your selected schedule and filters.</p>
                        }
                        else
                        {
                            <h5>No cars found</h5>
                            <p>No cars matched your selected filters.</p>
                        }
                    </div>
                }
            }

        </section>

    </main>

</div>