@page
@model VentureCarRentals.Pages.User.Bookings.IndexModel
@{
    ViewData["Title"] = "My Bookings";
    Layout = "_Layout";
}

<div class="user-wrapper">

    @await Html.PartialAsync("/Pages/User/_UserSidebar.cshtml")

    <main class="user-main">

        <div class="user-topbar">
            <div class="d-flex align-items-center gap-3">
                <button type="button" class="user-menu-btn" onclick="toggleUserSidebar()">
                    <i class="bi bi-list"></i>
                </button>

                <a asp-page="/User/Home" class="back-link">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
            </div>

            <i class="bi bi-bell notification-bell"></i>
        </div>

        <section class="my-bookings-section">

            <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                    <h3 class="mb-0">My Bookings</h3>
                    <p class="text-muted mb-0">View and manage your car rental bookings.</p>
                </div>

                <a asp-page="/User/Cars/BrowseCars" class="btn btn-primary">
                    <i class="bi bi-car-front"></i> Browse Cars
                </a>
            </div>

            <hr />

            @await Html.PartialAsync("_LiveBookingSection", Model)

            @await Html.PartialAsync("_BookingTabs", Model)

            <div class="booking-list-wrapper">
                @if (Model.DisplayedBookings.Any())
                {
                    foreach (var booking in Model.DisplayedBookings)
                    {
                        @await Html.PartialAsync("_BookingCard", booking)
                        @await Html.PartialAsync("_BookingDetailsModal", booking)

                        @if (booking.CanCancel)
                        {
                            @await Html.PartialAsync("_CancelBookingModal", booking)
                        }

                        @if (booking.CanReview)
                        {
                            @await Html.PartialAsync("_ReviewBookingModal", booking)
                        }
                    }
                }
                else
                {
                    <div class="empty-result-box">
                        <i class="bi bi-calendar-x"></i>
                        <h5>No bookings found</h5>
                        <p>No booking records are available for this selected category.</p>
                    </div>
                }
            </div>

        </section>

    </main>
</div>

@await Html.PartialAsync("_BookingConfirmModal")
@await Html.PartialAsync("_BookingToastMessages")

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            function formatDuration(milliseconds) {
                let totalSeconds = Math.floor(milliseconds / 1000);

                const days = Math.floor(totalSeconds / 86400);
                totalSeconds -= days * 86400;

                const hours = Math.floor(totalSeconds / 3600);
                totalSeconds -= hours * 3600;

                const minutes = Math.floor(totalSeconds / 60);
                const seconds = totalSeconds - minutes * 60;

                if (days > 0) {
                    return days + "d " + hours + "h " + minutes + "m " + seconds + "s";
                }

                return hours + "h " + minutes + "m " + seconds + "s";
            }

            function updateCountdowns() {
                document.querySelectorAll("[data-booking-countdown]").forEach(function (element) {
                    const endDateText = element.getAttribute("data-end-date");
                    const penaltyRate = parseFloat(element.getAttribute("data-penalty-rate") || "200");

                    const penaltyTargetId = element.getAttribute("data-penalty-target");
                    const statusTargetId = element.getAttribute("data-status-target");
                    const cardTargetId = element.getAttribute("data-card-target");

                    const endDate = new Date(endDateText);
                    const now = new Date();

                    const diff = endDate - now;

                    const penaltyTarget = penaltyTargetId ? document.getElementById(penaltyTargetId) : null;
                    const statusTarget = statusTargetId ? document.getElementById(statusTargetId) : null;
                    const cardTarget = cardTargetId ? document.getElementById(cardTargetId) : null;

                    if (diff > 0) {
                        element.textContent = formatDuration(diff) + " remaining";

                        if (penaltyTarget) {
                            penaltyTarget.textContent = "";
                        }

                        if (statusTarget) {
                            statusTarget.textContent = "Live";
                            statusTarget.className = "live-badge";
                        }

                        if (cardTarget) {
                            cardTarget.classList.remove("overdue-live-booking-card");
                        }

                        return;
                    }

                    const overdueMs = now - endDate;
                    const overdueMinutes = overdueMs / (1000 * 60);

                    /*
                        IMPORTANT:
                        UI penalty rule must match the backend:
                        - Behind schedule shows immediately after return time passes.
                        - Under 45 minutes late = no penalty.
                        - 45 minutes or more late = ₱200 per started hour.
                    */
                    let overdueHours = 0;
                    let penaltyAmount = 0;

                    if (overdueMinutes >= 45) {
                        overdueHours = Math.ceil(overdueMs / (1000 * 60 * 60));
                        penaltyAmount = overdueHours * penaltyRate;
                    }

                    element.textContent = "Behind schedule by " + formatDuration(overdueMs);

                    if (penaltyTarget) {
                        if (overdueMinutes < 45) {
                            penaltyTarget.textContent = "Grace period: No penalty yet. Penalty starts at 45 minutes late.";
                        }
                        else {
                            penaltyTarget.textContent = "Penalty: ₱" + penaltyAmount.toLocaleString(undefined, {
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            }) + " (₱200/hour)";
                        }
                    }

                    if (statusTarget) {
                        statusTarget.textContent = "Behind Schedule";
                        statusTarget.className = "badge bg-warning text-dark";
                    }

                    if (cardTarget) {
                        cardTarget.classList.add("overdue-live-booking-card");
                    }
                });
            }

            updateCountdowns();
            setInterval(updateCountdowns, 1000);

            let selectedForm = null;

            const confirmModalElement = document.getElementById("bookingConfirmModal");
            const confirmTitle = document.getElementById("bookingConfirmTitle");
            const confirmMessage = document.getElementById("bookingConfirmMessage");
            const confirmButton = document.getElementById("bookingConfirmButton");

            if (confirmModalElement) {
                const confirmModal = new bootstrap.Modal(confirmModalElement);

                document.querySelectorAll(".needs-booking-confirmation").forEach(function (form) {
                    form.addEventListener("submit", function (event) {
                        event.preventDefault();

                        selectedForm = form;

                        confirmTitle.textContent = form.dataset.confirmTitle || "Confirm Action";
                        confirmMessage.textContent = form.dataset.confirmMessage || "Are you sure you want to continue?";

                        confirmButton.className = "btn action-confirm-button";

                        if (form.dataset.confirmVariant === "danger") {
                            confirmButton.classList.add("btn-danger");
                        }
                        else {
                            confirmButton.classList.add("btn-primary");
                        }

                        confirmModal.show();
                    });
                });

                confirmButton.addEventListener("click", function () {
                    if (selectedForm) {
                        selectedForm.classList.remove("needs-booking-confirmation");
                        selectedForm.submit();
                    }
                });
            }

            document.querySelectorAll(".app-toast").forEach(function (toastElement) {
                const toast = new bootstrap.Toast(toastElement, {
                    delay: 3500
                });

                toast.show();
            });
        });
    </script>
}