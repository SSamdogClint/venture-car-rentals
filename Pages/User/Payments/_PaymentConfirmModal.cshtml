<!-- PAYMENT / BOOKING REQUEST CONFIRMATION MODAL -->
<div class="modal fade" id="paymentConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content action-confirm-modal">

            <div class="modal-header action-confirm-header">
                <h5 class="modal-title" id="paymentConfirmTitle">
                    Submit Booking Request
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body action-confirm-body">
                <p id="paymentConfirmMessage" class="mb-0">
                    Are you sure you want to submit this booking request?
                </p>
            </div>

            <div class="modal-footer action-confirm-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button" class="btn btn-primary action-confirm-button" id="paymentConfirmButton">
                    Continue
                </button>
            </div>

        </div>
    </div>
</div>