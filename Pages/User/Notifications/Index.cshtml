@page
@model VentureCarRentals.Pages.User.Notifications.IndexModel
@{
    ViewData["Title"] = "My Notifications";
    Layout = "_Layout";

    var successMessage = TempData["Success"] as string;
}

<div class="user-wrapper">

    @await Html.PartialAsync("/Pages/User/_UserSidebar.cshtml")

    <main class="user-main">

        <div class="user-topbar">
            <div class="d-flex align-items-center gap-3">
                <button type="button" class="user-menu-btn" onclick="toggleUserSidebar()">
                    <i class="bi bi-list"></i>
                </button>

                <a asp-page="/User/Home" class="back-link">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
            </div>

            @await Html.PartialAsync("_UserNotificationBell")
        </div>

        <section class="admin-notifications-page">

            <div class="admin-notifications-header">
                <div>
                    <h3>My Notifications</h3>
                    <p>View your booking and account notifications.</p>
                </div>

                <form method="post" asp-page-handler="MarkAllRead">
                    <button type="submit" class="btn btn-dark">
                        <i class="bi bi-check2-all"></i> Mark All as Read
                    </button>
                </form>
            </div>

            <div class="admin-notification-tabs">
                <a asp-page="/User/Notifications/Index"
                   asp-route-filter="all"
                   class="@(Model.Filter == "all" ? "active" : "")">
                    All <span>@Model.AllCount</span>
                </a>

                <a asp-page="/User/Notifications/Index"
                   asp-route-filter="unread"
                   class="@(Model.Filter == "unread" ? "active" : "")">
                    Unread <span>@Model.UnreadCount</span>
                </a>

                <a asp-page="/User/Notifications/Index"
                   asp-route-filter="read"
                   class="@(Model.Filter == "read" ? "active" : "")">
                    Read <span>@Model.ReadCount</span>
                </a>
            </div>

            <div class="admin-notification-list-card">
                @if (Model.Notifications.Any())
                {
                    foreach (var notification in Model.Notifications)
                    {
                        <div class="admin-notification-row @(notification.IsRead ? "" : "unread")">
                            <div class="admin-notification-row-icon">
                                @if (notification.Type == "booking")
                                {
                                    <i class="bi bi-calendar-check"></i>
                                }
                                else if (notification.Type == "penalty")
                                {
                                    <i class="bi bi-exclamation-triangle"></i>
                                }
                                else if (notification.Type == "maintenance")
                                {
                                    <i class="bi bi-tools"></i>
                                }
                                else if (notification.Type == "review")
                                {
                                    <i class="bi bi-star"></i>
                                }
                                else
                                {
                                    <i class="bi bi-bell"></i>
                                }
                            </div>

                            <div class="admin-notification-row-content">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <h5>@notification.Title</h5>

                                    @if (!notification.IsRead)
                                    {
                                        <span class="badge bg-danger">Unread</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Read</span>
                                    }

                                    <span class="badge bg-light text-dark">@notification.Type</span>
                                </div>

                                <p>@notification.Message</p>

                                <small>
                                    @notification.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")
                                </small>
                            </div>

                            <div class="admin-notification-row-actions">
                                <a href="@notification.TargetUrl" class="btn btn-sm btn-outline-dark">
                                    Open
                                </a>

                                @if (!notification.IsRead)
                                {
                                    <form method="post" asp-page-handler="MarkRead">
                                        <input type="hidden" name="id" value="@notification.NotificationId" />

                                        <button type="submit" class="btn btn-sm btn-success">
                                            Mark Read
                                        </button>
                                    </form>
                                }

                                <form method="post" asp-page-handler="Delete">
                                    <input type="hidden" name="id" value="@notification.NotificationId" />

                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-bell"></i>
                        <h5>No notifications found</h5>
                        <p>Your notifications will appear here.</p>
                    </div>
                }
            </div>

        </section>

    </main>
</div>

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 2000;">
        <div class="toast admin-notification-page-toast text-bg-success border-0" role="alert">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi bi-check-circle me-1"></i>
                    @successMessage
                </div>

                <button type="button"
                        class="btn-close btn-close-white me-2 m-auto"
                        data-bs-dismiss="toast">
                </button>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".admin-notification-page-toast").forEach(function (toastElement) {
                const toast = new bootstrap.Toast(toastElement, {
                    delay: 3500
                });

                toast.show();
            });
        });
    </script>
}