@page
@model VentureCarRentals.Pages.User.Reviews.IndexModel
@{
    ViewData["Title"] = "Reviews";
    Layout = "_Layout";
}

<div class="user-wrapper">

    @await Html.PartialAsync("/Pages/User/_UserSidebar.cshtml")

    <main class="user-main">

        <div class="user-topbar">
            <div class="d-flex align-items-center gap-3">
                <button type="button" class="user-menu-btn" onclick="toggleUserSidebar()">
                    <i class="bi bi-list"></i>
                </button>

                <a asp-page="/User/Home" class="text-decoration-none text-dark fw-semibold">
                    <i class="bi bi-arrow-left me-1"></i> Back
                </a>
            </div>

            @await Html.PartialAsync("_UserNotificationBell")
        </div>

        <section class="container-fluid py-4">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
                <div>
                    <h3 class="fw-bold mb-1">Customer Reviews</h3>
                    <p class="text-muted mb-0">
                        View customer feedback and ratings from completed bookings.
                    </p>
                </div>

                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body py-2 px-4 text-center">
                        <small class="text-muted d-block">Average Rating</small>

                        <div class="fw-bold fs-5">
                            <i class="bi bi-star-fill text-warning"></i>
                            @Model.AverageRating.ToString("0.0") / 5
                        </div>
                    </div>
                </div>
            </div>

            <hr />

            <div class="row g-3 mb-4">

                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <small class="text-muted">Total Reviews</small>
                                    <h3 class="fw-bold mb-0">@Model.TotalReviews</h3>
                                </div>

                                <div class="fs-1 text-primary">
                                    <i class="bi bi-chat-square-text"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <small class="text-muted">5-Star Reviews</small>
                                    <h3 class="fw-bold mb-0">@Model.FiveStarReviews</h3>
                                </div>

                                <div class="fs-1 text-warning">
                                    <i class="bi bi-star-fill"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <small class="text-muted">Reviewed Cars</small>
                                    <h3 class="fw-bold mb-0">@Model.ReviewedCars</h3>
                                </div>

                                <div class="fs-1 text-success">
                                    <i class="bi bi-car-front"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            @if (Model.Reviews.Any())
            {
                <div class="row g-4">

                    @foreach (var review in Model.Reviews)
                    {
                        <div class="col-xl-4 col-lg-6 col-md-6">
                            <div class="card border-0 shadow-sm rounded-4 h-100">

                                <div class="card-body p-4">

                                    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                                        <div>
                                            <h5 class="fw-bold mb-1">
                                                @review.CarName
                                            </h5>

                                            <small class="text-muted">
                                                Booking #@review.BookingId
                                            </small>
                                        </div>

                                        <span class="badge rounded-pill text-bg-primary px-3 py-2">
                                            @review.Rating / 5
                                        </span>
                                    </div>

                                    <div class="mb-3">
                                        @for (var i = 1; i <= 5; i++)
                                        {
                                            if (i <= review.Rating)
                                            {
                                                <i class="bi bi-star-fill text-warning"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star text-warning"></i>
                                            }
                                        }
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(review.Comment))
                                    {
                                        <p class="text-muted">
                                            "@review.Comment"
                                        </p>
                                    }
                                    else
                                    {
                                        <p class="text-muted fst-italic">
                                            No written comment was provided.
                                        </p>
                                    }

                                    <hr />

                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold"
                                             style="width: 44px; height: 44px;">
                                            @review.Initials
                                        </div>

                                        <div>
                                            <strong class="d-block">@review.ReviewerName</strong>
                                            <small class="text-muted">
                                                @review.CreatedAt.ToString("MMM dd, yyyy")
                                            </small>
                                        </div>
                                    </div>

                                </div>

                            </div>
                        </div>
                    }

                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body text-center py-5">

                        <div class="display-4 text-muted mb-3">
                            <i class="bi bi-star"></i>
                        </div>

                        <h5 class="fw-bold">No reviews yet</h5>

                        <p class="text-muted mb-0">
                            Reviews will appear here after customers rate their completed bookings.
                        </p>

                    </div>
                </div>
            }

        </section>

    </main>
</div>