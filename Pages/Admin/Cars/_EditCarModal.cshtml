@model VentureCarRentals.Models.Car

<!-- EDIT CAR MODAL -->
<div class="modal fade" id="editCarModal-@Model.CarId" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content admin-modal">

            <form method="post"
                  asp-page="/Admin/Cars/CarPage"
                  asp-page-handler="Edit"
                  enctype="multipart/form-data"
                  class="needs-confirmation"
                  data-confirm-title="Save Car Changes"
                  data-confirm-message="Are you sure you want to save the updated car information?"
                  data-confirm-variant="primary">

                <div class="modal-header">
                    <h5 class="modal-title">Edit Car Info</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <input type="hidden" name="EditCarId" value="@Model.CarId" />

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label">Make</label>
                            <input name="EditMake" value="@Model.Make" class="form-control" placeholder="Toyota" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Model</label>
                            <input name="EditModel" value="@Model.Model" class="form-control" placeholder="Vios" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Year</label>
                            <input name="EditYear" value="@Model.Year" type="number" class="form-control" placeholder="2024" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Color</label>
                            <input name="EditColor" value="@Model.Color" class="form-control" placeholder="Silver" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Category</label>
                            <input name="EditCategory" value="@Model.Category" class="form-control" placeholder="Sedan, SUV, Van" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Price Per Day</label>
                            <input name="EditPricePerDay" value="@Model.PricePerDay" type="number" step="0.01" class="form-control" placeholder="2500" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Seats</label>
                            <input name="EditSeats" value="@Model.Seats" type="number" class="form-control" placeholder="5" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Transmission</label>
                            <select name="EditTransmission" class="form-control" required>
                                <option value="Automatic" selected="@(Model.Transmission == "Automatic")">Automatic</option>
                                <option value="Manual" selected="@(Model.Transmission == "Manual")">Manual</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">License Plate</label>
                            <input name="EditLicensePlate" value="@Model.LicensePlate" class="form-control" placeholder="ABC 1234" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">VIN</label>
                            <input name="EditVIN" value="@Model.VIN" class="form-control" placeholder="Vehicle Identification Number" required />
                        </div>

                        <div class="col-md-12">
                            <label class="form-label">Replace Car Image</label>
                            <input name="EditCarImage" type="file" class="form-control" accept="image/*" />
                            <small class="text-muted">Leave empty to keep the current image. Maximum size is 50 MB.</small>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label">Description</label>
                            <textarea name="EditDescription" class="form-control" rows="3" placeholder="Car description">@Model.Description</textarea>
                        </div>

                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit" class="btn btn-primary">
                        Save Changes
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>