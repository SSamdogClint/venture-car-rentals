@model VentureCarRentals.Models.Car

<!-- DETAILS MODAL -->
<div class="modal fade" id="carDetailsModal-@Model.CarId" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content admin-modal">

            <div class="modal-header">
                <h5 class="modal-title">@Model.Make @Model.Model</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="row g-4">

                    <div class="col-lg-4">
                        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" class="modal-car-img" alt="@Model.Make @Model.Model" />
                        }
                        else
                        {
                            <div class="no-image-box">
                                <i class="bi bi-car-front"></i>
                                <span>No image available</span>
                            </div>
                        }

                        <div class="mt-3">
                            <strong>Description:</strong>
                            <p class="text-muted mt-1">@Model.Description</p>
                        </div>
                    </div>

                    <div class="col-lg-8">
                        <div class="car-detail-grid">
                            <p><strong>Car ID:</strong> @Model.CarId.ToString("0000")</p>
                            <p><strong>Make:</strong> @Model.Make</p>
                            <p><strong>Model:</strong> @Model.Model</p>
                            <p><strong>Year:</strong> @Model.Year</p>
                            <p><strong>Color:</strong> @Model.Color</p>
                            <p><strong>Category:</strong> @Model.Category</p>
                            <p><strong>Seats:</strong> @Model.Seats</p>
                            <p><strong>Transmission:</strong> @Model.Transmission</p>
                            <p><strong>Price Per Day:</strong> ₱@Model.PricePerDay.ToString("N2")</p>
                            <p><strong>Status:</strong> <span class="text-capitalize">@Model.Status</span></p>
                            <p><strong>License Plate:</strong> @Model.LicensePlate</p>
                            <p><strong>VIN:</strong> @Model.VIN</p>
                            <p><strong>Created At:</strong> @Model.CreatedAt.ToString("MMM dd, yyyy")</p>
                        </div>

                        <hr />

                        <button type="button"
                                class="btn btn-primary w-100"
                                data-bs-dismiss="modal"
                                data-bs-toggle="modal"
                                data-bs-target="#editCarModal-@Model.CarId">
                            <i class="bi bi-pencil-square"></i> Edit Car Info
                        </button>

                        <hr />

                        <!-- UPDATE STATUS ONLY -->
                        <form method="post"
                              asp-page="/Admin/Cars/CarPage"
                              asp-page-handler="UpdateStatus"
                              class="needs-confirmation"
                              data-confirm-title="Update Car Status"
                              data-confirm-message="Are you sure you want to update this car status?"
                              data-confirm-variant="primary">

                            <input type="hidden" name="CarId" value="@Model.CarId" />

                            <label class="form-label">Quick Status Update</label>

                            <div class="d-flex gap-2">
                                <select name="Status" class="form-control">
                                    <option value="available" selected="@(Model.Status == "available")">available</option>
                                    <option value="booked" selected="@(Model.Status == "booked")">booked</option>
                                    <option value="maintenance" selected="@(Model.Status == "maintenance")">maintenance</option>
                                    <option value="inactive" selected="@(Model.Status == "inactive")">inactive</option>
                                </select>

                                <button type="submit" class="btn btn-primary">
                                    Update
                                </button>
                            </div>
                        </form>

                        <hr />

                        <!-- DELETE CAR -->
                        <form method="post"
                              asp-page="/Admin/Cars/CarPage"
                              asp-page-handler="Delete"
                              class="needs-confirmation"
                              data-confirm-title="Delete Car"
                              data-confirm-message="Are you sure you want to delete this car? This action cannot be undone."
                              data-confirm-variant="danger">

                            <input type="hidden" name="CarId" value="@Model.CarId" />

                            <button type="submit" class="btn btn-danger w-100">
                                <i class="bi bi-trash"></i> Delete Car
                            </button>
                        </form>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>