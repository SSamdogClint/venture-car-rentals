@page
@model VentureCarRentals.Pages.Admin.Cars.CarPageModel
@{
    ViewData["Title"] = "Cars";
    Layout = "_Layout";

    /*
        IMPORTANT FEATURE:
        This main page is kept clean by moving Add, Edit, Details,
        Confirmation, and Toast UI into separate partial files.
    */
}

<div class="row g-4">

    <!-- LEFT STATISTICS -->
    <div class="col-lg-3">
        <div class="dashboard-header mb-3">
            <h5>Todays Statistics</h5>
            <p>@DateTime.Now.ToString("ddd, dd MMMM, yyyy, hh:mm tt")</p>
        </div>

        <div class="stat-card">
            <div class="d-flex justify-content-between">
                <span>Available</span>
                <small>Today</small>
            </div>

            <h3>@Model.AvailableCars</h3>
            <p>Available cars in the system</p>
            <strong>Total Cars <span>@Model.TotalCars</span></strong>
        </div>

        <div class="stat-card">
            <div class="d-flex justify-content-between">
                <span>Not Available</span>
                <small>Today</small>
            </div>

            <h3>@Model.NotAvailableCars</h3>
            <p>Booked, maintenance, or inactive cars</p>
            <strong>Total Cars <span>@Model.TotalCars</span></strong>
        </div>

        <div class="stat-card">
            <div class="d-flex justify-content-between">
                <span>Available vs Not Available</span>
                <small>Today</small>
            </div>

            <div class="donut-chart car-donut mx-auto my-3"
                 data-available-percent="@Model.AvailablePercent">
            </div>

            <div class="chart-label">
                <p>
                    <span><span class="dot green"></span>Total Available</span>
                    <b>@Model.AvailablePercent%</b>
                </p>

                <p>
                    <span><span class="dot dark"></span>Total Not Available</span>
                    <b>@Model.NotAvailablePercent%</b>
                </p>
            </div>
        </div>
    </div>

    <!-- RIGHT CAR LIST -->
    <div class="col-lg-9">

        <div class="topbar mb-4">
            <div></div>

            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-bell-fill notification-icon"></i>

                <form method="get" class="search-box">
                    <input type="text" name="SearchTerm" value="@Model.SearchTerm" placeholder="Search here">
                    <button type="submit" class="border-0 bg-transparent">
                        <i class="bi bi-search"></i>
                    </button>
                </form>
            </div>
        </div>

        <div class="content-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h6 class="mb-0">Car List</h6>
                    <span class="text-muted small">
                        Showing @Model.Cars.Count car(s)
                    </span>
                </div>

                <button class="btn add-car-btn" data-bs-toggle="modal" data-bs-target="#addCarModal">
                    <i class="bi bi-plus-circle"></i> Add Car
                </button>
            </div>

            <div class="table-responsive">
                <table class="table align-middle admin-table">
                    <thead>
                        <tr>
                            <th>No.</th>
                            <th>Car no.</th>
                            <th>Car Model</th>
                            <th>Status</th>
                            <th>Seater</th>
                            <th>Price / Day</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Cars.Any())
                        {
                            var count = 1;

                            foreach (var car in Model.Cars)
                            {
                                <tr>
                                    <td>@count.ToString("00")</td>

                                    <td>
                                        <span class="car-code">@car.CarId.ToString("0000")</span>
                                    </td>

                                    <td>
                                        <strong>@car.Make @car.Model</strong>
                                        <br />
                                        <small class="text-muted">
                                            @car.Year • @car.Color • @car.Category • @car.Transmission
                                        </small>
                                    </td>

                                    <td>
                                        <span class="status @(car.Status == "available" ? "available" : "unavailable")"></span>
                                        <span class="text-capitalize">@car.Status</span>
                                    </td>

                                    <td>@car.Seats</td>

                                    <td>₱@car.PricePerDay.ToString("N2")</td>

                                    <td>
                                        <button class="details-btn"
                                                data-bs-toggle="modal"
                                                data-bs-target="#carDetailsModal-@car.CarId">
                                            Details
                                        </button>
                                    </td>
                                </tr>

                                count++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-5">
                                    No cars found in the database yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

@await Html.PartialAsync("_AddCarModal", Model)

@foreach (var car in Model.Cars)
{
    @await Html.PartialAsync("_CarDetailsModal", car)
    @await Html.PartialAsync("_EditCarModal", car)
}

@await Html.PartialAsync("_ConfirmActionModal")
@await Html.PartialAsync("_CarToastMessages")

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let selectedForm = null;

            const confirmModalElement = document.getElementById("confirmActionModal");
            const confirmTitle = document.getElementById("confirmActionTitle");
            const confirmMessage = document.getElementById("confirmActionMessage");
            const confirmButton = document.getElementById("confirmActionButton");

            /*
                IMPORTANT FEATURE:
                This script reuses one confirmation modal for Add, Edit, Status Update, and Delete.
                The button color changes depending on the action type.
            */
            if (confirmModalElement) {
                const confirmModal = new bootstrap.Modal(confirmModalElement);

                document.querySelectorAll(".needs-confirmation").forEach(function (form) {
                    form.addEventListener("submit", function (event) {
                        event.preventDefault();

                        // Run HTML required-field validation first.
                        if (!form.checkValidity()) {
                            form.reportValidity();
                            return;
                        }

                        selectedForm = form;

                        const confirmVariant = form.dataset.confirmVariant || "primary";

                        confirmTitle.textContent = form.dataset.confirmTitle || "Confirm Action";
                        confirmMessage.textContent = form.dataset.confirmMessage || "Are you sure you want to continue?";

                        confirmButton.className = "btn action-confirm-button";

                        if (confirmVariant === "danger") {
                            confirmButton.classList.add("btn-danger");
                        }
                        else {
                            confirmButton.classList.add("btn-primary");
                        }

                        confirmModal.show();
                    });
                });

                confirmButton.addEventListener("click", function () {
                    if (selectedForm) {
                        selectedForm.classList.remove("needs-confirmation");
                        selectedForm.submit();
                    }
                });
            }

            // Apply donut chart background without using inline style in the cshtml.
            document.querySelectorAll(".car-donut").forEach(function (donut) {
                const percent = donut.dataset.availablePercent || 0;
                donut.style.background = `conic-gradient(#4ade80 0 ${percent}%, #111 ${percent}% 100%)`;
            });

            // Show toast messages.
            document.querySelectorAll(".app-toast").forEach(function (toastElement) {
                const toast = new bootstrap.Toast(toastElement, {
                    delay: 3500
                });

                toast.show();
            });
        });
    </script>
}