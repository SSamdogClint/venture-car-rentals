@page
@model VentureCarRentals.Pages.Admin.Payments.PaymentDetailsModel
@{
    ViewData["Title"] = "Payment Details";
    Layout = "_Layout";
}

<div class="container-fluid">

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Payment Details</h3>
            <p class="text-muted mb-0">
                View, filter, monitor, and export customer payment records.
            </p>
        </div>

        <a asp-page-handler="DownloadPdf"
           asp-route-SearchTerm="@Model.SearchTerm"
           asp-route-PaymentStatusFilter="@Model.PaymentStatusFilter"
           asp-route-PaymentMethodFilter="@Model.PaymentMethodFilter"
           asp-route-FromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
           asp-route-ToDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
           class="btn btn-danger">
            <i class="bi bi-file-earmark-pdf"></i>
            Download PDF
        </a>
    </div>

    <!-- STATISTICS CARDS -->
    <div class="row g-3 mb-4">

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted mb-1">Total Payments</p>
                            <h3 class="fw-bold mb-0">@Model.TotalPayments</h3>
                        </div>

                        <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center"
                             style="width:45px;height:45px;">
                            <i class="bi bi-receipt fs-5"></i>
                        </div>
                    </div>

                    <small class="text-muted">All payment records</small>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted mb-1">Collected Amount</p>
                            <h3 class="fw-bold mb-0">₱@Model.TotalCollectedAmount.ToString("N2")</h3>
                        </div>

                        <div class="bg-success-subtle text-success rounded-circle d-flex align-items-center justify-content-center"
                             style="width:45px;height:45px;">
                            <i class="bi bi-cash-coin fs-5"></i>
                        </div>
                    </div>

                    <small class="text-muted">
                        Paid payments only
                    </small>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted mb-1">Pending Payments</p>
                            <h3 class="fw-bold mb-0">@Model.PendingPayments</h3>
                        </div>

                        <div class="bg-warning-subtle text-warning rounded-circle d-flex align-items-center justify-content-center"
                             style="width:45px;height:45px;">
                            <i class="bi bi-hourglass-split fs-5"></i>
                        </div>
                    </div>

                    <small class="text-muted">
                        ₱@Model.PendingAmount.ToString("N2") not yet collected
                    </small>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted mb-1">Refunded</p>
                            <h3 class="fw-bold mb-0">@Model.RefundedPayments</h3>
                        </div>

                        <div class="bg-danger-subtle text-danger rounded-circle d-flex align-items-center justify-content-center"
                             style="width:45px;height:45px;">
                            <i class="bi bi-arrow-counterclockwise fs-5"></i>
                        </div>
                    </div>

                    <small class="text-muted">
                        ₱@Model.RefundedAmount.ToString("N2") refunded amount
                    </small>
                </div>
            </div>
        </div>

    </div>

    <!-- FILTER CARD -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body">

            <form method="get" class="row g-3 align-items-end">

                <div class="col-lg-3 col-md-6">
                    <label class="form-label">Search</label>
                    <input type="text"
                           name="SearchTerm"
                           value="@Model.SearchTerm"
                           class="form-control"
                           placeholder="Search renter, email, car, booking ID..." />
                </div>

                <div class="col-lg-2 col-md-6">
                    <label class="form-label">Payment Status</label>
                    <select name="PaymentStatusFilter" class="form-control">
                        <option value="">All Status</option>
                        <option value="pending_admin_approval" selected="@(Model.PaymentStatusFilter == "pending_admin_approval")">
                            pending admin approval
                        </option>
                        <option value="unpaid" selected="@(Model.PaymentStatusFilter == "unpaid")">
                            unpaid
                        </option>
                        <option value="paid" selected="@(Model.PaymentStatusFilter == "paid")">
                            paid
                        </option>
                        <option value="refunded" selected="@(Model.PaymentStatusFilter == "refunded")">
                            refunded
                        </option>
                    </select>
                </div>

                <div class="col-lg-2 col-md-6">
                    <label class="form-label">Payment Method</label>
                    <select name="PaymentMethodFilter" class="form-control">
                        <option value="">All Methods</option>

                        @foreach (var method in Model.PaymentMethods)
                        {
                            <option value="@method" selected="@(Model.PaymentMethodFilter == method)">
                                @method.Replace("_", " ")
                            </option>
                        }
                    </select>
                </div>

                <div class="col-lg-2 col-md-6">
                    <label class="form-label">From Date</label>
                    <input type="date"
                           name="FromDate"
                           value="@Model.FromDate?.ToString("yyyy-MM-dd")"
                           class="form-control" />
                </div>

                <div class="col-lg-2 col-md-6">
                    <label class="form-label">To Date</label>
                    <input type="date"
                           name="ToDate"
                           value="@Model.ToDate?.ToString("yyyy-MM-dd")"
                           class="form-control" />
                </div>

                <div class="col-lg-1 col-md-6 d-grid">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-funnel"></i>
                    </button>
                </div>

                <div class="col-12">
                    <a asp-page="/Admin/Payments/PaymentDetails" class="btn btn-light">
                        Clear Filters
                    </a>
                </div>

            </form>

        </div>
    </div>

    <!-- TABLE CARD -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold mb-0">Payment Records</h5>
                    <small class="text-muted">
                        Showing @Model.Payments.Count payment record(s)
                    </small>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Payment ID</th>
                            <th>Booking ID</th>
                            <th>Renter</th>
                            <th>Vehicle</th>
                            <th>Booking Date</th>
                            <th>Method</th>
                            <th>Status</th>
                            <th class="text-end">Amount</th>
                            <th class="text-end">Collected</th>
                            <th>Paid At</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Payments.Any())
                        {
                            foreach (var payment in Model.Payments)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-semibold">#@payment.PaymentId</span>
                                    </td>

                                    <td>
                                        <span class="fw-semibold">#@payment.BookingId</span>
                                    </td>

                                    <td>
                                        <strong>@payment.RenterName</strong>
                                        <br />
                                        <small class="text-muted">@payment.RenterEmail</small>
                                    </td>

                                    <td>
                                        <strong>@payment.CarName</strong>
                                        <br />
                                        <small class="text-muted">@payment.CarCategory</small>
                                    </td>

                                    <td>
                                        @if (payment.BookingCreatedAt != null)
                                        {
                                            @payment.BookingCreatedAt.Value.ToString("MMM dd, yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>

                                    <td>
                                        <span class="text-capitalize">
                                            @payment.DisplayPaymentMethod
                                        </span>
                                    </td>

                                    <td>
                                        @if (payment.PaymentStatus == "paid")
                                        {
                                            <span class="badge bg-success">paid</span>
                                        }
                                        else if (payment.PaymentStatus == "refunded")
                                        {
                                            <span class="badge bg-danger">refunded</span>
                                        }
                                        else if (payment.PaymentStatus == "pending_admin_approval")
                                        {
                                            <span class="badge bg-warning text-dark">pending admin approval</span>
                                        }
                                        else if (payment.PaymentStatus == "unpaid")
                                        {
                                            <span class="badge bg-secondary">unpaid</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border">
                                                @payment.DisplayPaymentStatus
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        ₱@payment.Amount.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        @if (payment.IsPaid)
                                        {
                                            <strong class="text-success">
                                                ₱@payment.Amount.ToString("N2")
                                            </strong>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not collected</span>
                                        }
                                    </td>

                                    <td>
                                        @if (payment.PaidAt != null)
                                        {
                                            @payment.PaidAt.Value.ToString("MMM dd, yyyy hh:mm tt")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not paid</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center text-muted py-5">
                                    No payment records found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>

</div>