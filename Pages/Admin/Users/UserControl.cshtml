@page
@model VentureCarRentals.Pages.Admin.Users.UserControlModel
@{
    ViewData["Title"] = "Users";
    Layout = "_Layout";

    /*
        IMPORTANT FEATURE:
        User Control now uses the same verification logic as Document Verification.

        If a user has only 1 approved required document,
        the user is still Pending and not yet Verified.
    */
}

<div class="row g-4">

    <!-- LEFT STATISTICS -->
    <div class="col-lg-3">
        <div class="dashboard-header mb-3">
            <h5>User Statistics</h5>
            <p>@DateTime.Now.ToString("ddd, dd MMMM, yyyy, hh:mm tt")</p>
        </div>

        <div class="stat-card @(Model.UserStatusFilter == "all" ? "active-doc-filter" : "")">
            <div class="d-flex justify-content-between">
                <span>Total Users</span>
                <small>All</small>
            </div>

            <h3>@Model.TotalUsers</h3>
            <p>Registered customer accounts</p>

            <div class="stat-card-footer">
                <strong>Users <span>@Model.TotalUsers</span></strong>

                <a asp-page="/Admin/Users/UserControl"
                   asp-route-UserStatusFilter="all"
                   class="stat-card-view">
                    View <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="stat-card @(Model.UserStatusFilter == "verified" ? "active-doc-filter" : "")">
            <div class="d-flex justify-content-between">
                <span>Verified</span>
                <small>Approved</small>
            </div>

            <h3>@Model.VerifiedUsers</h3>
            <p>Users with all required documents approved</p>

            <div class="stat-card-footer">
                <strong>Verified <span>@Model.VerifiedUsers</span></strong>

                <a asp-page="/Admin/Users/UserControl"
                   asp-route-UserStatusFilter="verified"
                   class="stat-card-view">
                    View <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="stat-card @(Model.UserStatusFilter == "pending" ? "active-doc-filter" : "")">
            <div class="d-flex justify-content-between">
                <span>Pending</span>
                <small>Review</small>
            </div>

            <h3>@Model.PendingUsers</h3>
            <p>Users not fully verified yet</p>

            <div class="stat-card-footer">
                <strong>Pending <span>@Model.PendingUsers</span></strong>

                <a asp-page="/Admin/Users/UserControl"
                   asp-route-UserStatusFilter="pending"
                   class="stat-card-view">
                    View <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="stat-card @(Model.UserStatusFilter == "rejected" ? "active-doc-filter" : "")">
            <div class="d-flex justify-content-between">
                <span>Rejected</span>
                <small>Denied</small>
            </div>

            <h3>@Model.RejectedUsers</h3>
            <p>Users with rejected required documents</p>

            <div class="stat-card-footer">
                <strong>Rejected <span>@Model.RejectedUsers</span></strong>

                <a asp-page="/Admin/Users/UserControl"
                   asp-route-UserStatusFilter="rejected"
                   class="stat-card-view">
                    View <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="stat-card @(Model.UserStatusFilter == "expired" ? "active-doc-filter" : "")">
            <div class="d-flex justify-content-between">
                <span>Expired</span>
                <small>Date</small>
            </div>

            <h3>@Model.ExpiredUsers</h3>
            <p>Users with expired required documents</p>

            <div class="stat-card-footer">
                <strong>Expired <span>@Model.ExpiredUsers</span></strong>

                <a asp-page="/Admin/Users/UserControl"
                   asp-route-UserStatusFilter="expired"
                   class="stat-card-view">
                    View <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="stat-card @(Model.UserStatusFilter == "incomplete" ? "active-doc-filter" : "")">
            <div class="d-flex justify-content-between">
                <span>Incomplete</span>
                <small>Missing</small>
            </div>

            <h3>@Model.IncompleteUsers</h3>
            <p>Users missing profile or no submitted requirements</p>

            <div class="stat-card-footer">
                <strong>Incomplete <span>@Model.IncompleteUsers</span></strong>

                <a asp-page="/Admin/Users/UserControl"
                   asp-route-UserStatusFilter="incomplete"
                   class="stat-card-view">
                    View <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- RIGHT CONTENT -->
    <div class="col-lg-9">

        <div class="topbar mb-4">
            <div></div>

            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-bell-fill notification-icon"></i>

                <form method="get" class="search-box">
                    @if (!string.IsNullOrWhiteSpace(Model.UserStatusFilter))
                    {
                        <input type="hidden" name="UserStatusFilter" value="@Model.UserStatusFilter" />
                    }

                    <input type="text"
                           name="SearchTerm"
                           value="@Model.SearchTerm"
                           placeholder="Search users">

                    <button type="submit" class="border-0 bg-transparent">
                        <i class="bi bi-search"></i>
                    </button>
                </form>
            </div>
        </div>

        <div class="content-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h6 class="mb-0">@Model.UserListTitle</h6>
                    <span class="text-muted small">
                        @Model.UserListSubtitle • Showing @Model.Users.Count user(s)
                    </span>
                </div>

                <div class="d-flex gap-2">
                    @if (!string.IsNullOrWhiteSpace(Model.UserStatusFilter))
                    {
                        <a asp-page="/Admin/Users/UserControl" class="btn btn-light">
                            Show All Users
                        </a>
                    }

                    <a asp-page="/Admin/Documents/Verification" class="btn add-car-btn">
                        <i class="bi bi-file-earmark-check"></i> Verify Documents
                    </a>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table align-middle admin-table">
                    <thead>
                        <tr>
                            <th>No.</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Required Docs</th>
                            <th>Approved</th>
                            <th>Status</th>
                            <th>Registered</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Users.Any())
                        {
                            var count = 1;

                            foreach (var user in Model.Users)
                            {
                                <tr>
                                    <td>@count.ToString("00")</td>

                                    <td>
                                        <strong>@user.FullName</strong>
                                        <br />
                                        <small class="text-muted">@user.Country</small>
                                    </td>

                                    <td>@user.Email</td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(user.PhoneNumber))
                                        {
                                            @user.PhoneNumber
                                        }
                                        else
                                        {
                                            <span class="text-muted">No phone</span>
                                        }
                                    </td>

                                    <td>
                                        @user.RequiredSubmittedCount / @user.RequiredDocumentTotal required
                                        <br />
                                        <small class="text-muted">
                                            @user.DocumentCount total upload(s)
                                        </small>
                                    </td>

                                    <td>
                                        @user.RequiredApprovedCount / @user.RequiredDocumentTotal approved
                                    </td>

                                    <td>
                                        @if (user.VerificationStatus == "Verified")
                                        {
                                            <span class="badge bg-success">Verified</span>
                                        }
                                        else if (user.VerificationStatus == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                        else if (user.VerificationStatus == "Rejected")
                                        {
                                            <span class="badge bg-danger">Rejected</span>
                                        }
                                        else if (user.VerificationStatus == "Expired")
                                        {
                                            <span class="badge bg-danger">Expired</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Incomplete</span>
                                        }
                                    </td>

                                    <td>@user.CreatedAt.ToString("MMM dd, yyyy")</td>

                                    <td>
                                        <a asp-page="/Admin/Documents/Verification"
                                           asp-route-UserId="@user.UserId"
                                           class="details-btn">
                                            View
                                        </a>
                                    </td>
                                </tr>

                                count++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-5">
                                    No users found for this filter.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>