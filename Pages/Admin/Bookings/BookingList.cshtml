@page
@model VentureCarRentals.Pages.Admin.Bookings.BookingListModel
@{
    ViewData["Title"] = "Booking List";
    Layout = "_Layout";

    var currentTab = string.IsNullOrWhiteSpace(Model.Tab) ? "live" : Model.Tab.ToLower();
    var successMessage = TempData["Success"] as string;
    var errorMessage = TempData["Error"] as string;
}

<div class="admin-booking-layout">

    @await Html.PartialAsync("_BookingStatsPanel", Model)

    <section class="booking-list-panel">

        <div class="booking-topbar">
            <form method="get" class="booking-search-form">
                <input type="hidden" name="tab" value="@currentTab" />
                <input type="hidden" name="viewMode" value="@Model.ViewMode" />
                <input type="hidden" name="statType" value="@Model.StatType" />
                <input type="hidden" name="statRange" value="@Model.StatRange" />

                <input type="text"
                       name="searchTerm"
                       value="@Model.SearchTerm"
                       class="form-control"
                       placeholder="Search booking by ID, customer, email, or car" />

                <button type="submit" class="btn btn-light">
                    <i class="bi bi-search"></i>
                </button>
            </form>
        </div>

        @if (Model.ViewMode == "stats")
        {
            @await Html.PartialAsync("_BookingStatsGraphPanel", Model)
        }
        else
        {
            @await Html.PartialAsync("_BookingTabs", Model)
            @await Html.PartialAsync("_BookingTable", Model)
        }

    </section>
</div>

@await Html.PartialAsync("_BookingDetailsModals", Model)
@await Html.PartialAsync("_AdminBookingConfirmModal")
@await Html.PartialAsync("_AdminBookingToastMessages")

@section Scripts {
    @await Html.PartialAsync("_AdminBookingScripts", Model)
}